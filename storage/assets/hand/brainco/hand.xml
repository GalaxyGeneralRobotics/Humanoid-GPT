<mujoco model="hand_brainco">
  <!-- BrainCo (强脑) 5-finger dexterous hand. Geometry / poses / inertia migrated from the
       original BrainCo G1 model (the hand used by deploy/brainco/*; its joint ranges
       1.5184 / 1.0472 / 1.4661 / 1.6930 match deploy.brainco's qpos->cmd maps).
       Authored as two top-level bodies `left_hand` / `right_hand` anchored at the
       `*_wrist_yaw_link` origin so the hand-aware loader (utils/hand.py) can attach them onto
       either G1 hardware version. Finger joints are kept for teleoperation / grasping; the
       tracking loader strips them to obtain a rigid hand (no extra DoF). -->
  <compiler angle="radian" meshdir="meshes"/>

  <asset>
    <mesh name="left_base_link" file="left_base_link.STL"/>
    <mesh name="left_thumb_metacarpal_Link" file="left_thumb_metacarpal_Link.STL"/>
