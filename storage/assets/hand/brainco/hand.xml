    <mesh name="left_thumb_tip_Link" file="left_thumb_tip_Link.STL"/>
    <mesh name="left_index_proximal_Link" file="left_index_proximal_Link.STL"/>
    <mesh name="left_index_distal_Link" file="left_index_distal_Link.STL"/>
    <mesh name="left_index_tip_Link" file="left_index_tip_Link.STL"/>
